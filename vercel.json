{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://trendytoyz-backend.onrender.com/api/:match*"
    },
    {
      "source": "/uploads/:match*",
      "destination": "https://trendytoyz-backend.onrender.com/uploads/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
